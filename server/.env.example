# Порт локального API (nginx проксирует /api на него)
PORT=8787

# Postgres. Пароль замени на свой надёжный.
DATABASE_URL=postgres://shaman:CHANGE_ME_STRONG_PASSWORD@localhost:5432/shamandrums

# Telegram: токен бота от @BotFather (бот @Shamtatur)
TELEGRAM_BOT_TOKEN=PUT_REAL_BOT_TOKEN_HERE

# Куда слать заявки: chat_id получателя.
# - для приватной группы это число вида -1001234567890 (бот должен быть в группе)
# - для пользователя — его числовой id (пользователь должен нажать Start у бота)
TELEGRAM_CHAT_ID=PUT_CHAT_ID_HERE

# Можно оставить пустым в проде (сайт и API на одном домене). Для отладки: https://shamandrums.ru
# CORS_ORIGIN=https://shamandrums.ru
